# Epoch allocator (smallocator) API base URL.
# Used for chain config (/health) and SDK API calls.
VITE_API_BASE_URL=http://localhost:3000

# Miden Testnet endpoints. Both are required by the Miden client.
VITE_MIDEN_RPC_URL=https://rpc.testnet.miden.io
VITE_MIDEN_NOTE_TRANSPORT_URL=https://transport.miden.io
